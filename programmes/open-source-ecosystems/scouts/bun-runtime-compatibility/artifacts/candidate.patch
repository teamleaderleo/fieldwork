diff --git a/test/js/node/child_process/execfile-timeout-single-owner.test.js b/test/js/node/child_process/execfile-timeout-single-owner.test.js
new file mode 100644
--- /dev/null
+++ b/test/js/node/child_process/execfile-timeout-single-owner.test.js
@@
+import { expect, test } from "bun:test";
+import { execFile } from "node:child_process";
+
+test.skipIf(process.platform === "win32")(
+  "execFile timeout calls ChildProcess.kill once when the timeout signal is handled",
+  async () => {
+    const childSource = `
+      process.on("SIGUSR1", () => {});
+      process.stdout.write("ready\\n");
+      setInterval(() => {}, 1000);
+    `;
+
+    let callbackError;
+    let resolveCallback;
+    const callbackDone = new Promise(resolve => {
+      resolveCallback = resolve;
+    });
+
+    const child = execFile(
+      process.execPath,
+      ["-e", childSource],
+      { timeout: 1000, killSignal: "SIGUSR1" },
+      error => {
+        callbackError = error;
+        resolveCallback();
+      },
+    );
+
+    const originalKill = child.kill.bind(child);
+    const timeoutKillCalls = [];
+    child.kill = signal => {
+      timeoutKillCalls.push(signal);
+      return originalKill(signal);
+    };
+
+    await new Promise((resolve, reject) => {
+      child.stdout.once("data", resolve);
+      child.once("error", reject);
+    });
+
+    // The timeout starts before the child prints "ready". Waiting beyond the
+    // full timeout from readiness guarantees every timeout owner has run.
+    await Bun.sleep(1200);
+    expect(timeoutKillCalls).toHaveLength(1);
+
+    // Cleanup uses the original method so it stays outside the measured count.
+    originalKill("SIGKILL");
+    await callbackDone;
+    expect(callbackError?.signal).toBe("SIGKILL");
+  },
+  5000,
+);
