diff --git a/test/js/node/child_process/child_process.test.ts b/test/js/node/child_process/child_process.test.ts
--- a/test/js/node/child_process/child_process.test.ts
+++ b/test/js/node/child_process/child_process.test.ts
@@
+it.if(!isWindows)("execFile timeout invokes ChildProcess.kill once", async () => {
+  // SIGCONT is non-terminating for an already-running process, so the child
+  // stays alive long enough to expose duplicate timeout owners deterministically.
+  const child = execFile("sleep", ["10"], { timeout: 300, killSignal: "SIGCONT" }, () => {});
+  const closed = once(child, "close");
+  const originalKill = child.kill.bind(child);
+  const timeoutKillCalls: unknown[] = [];
+
+  child.kill = signal => {
+    timeoutKillCalls.push(signal);
+    return originalKill(signal);
+  };
+
+  try {
+    await Bun.sleep(600);
+    expect(timeoutKillCalls).toHaveLength(1);
+    expect(child.exitCode).toBeNull();
+  } finally {
+    // Cleanup deliberately bypasses the wrapper so it is not counted.
+    originalKill("SIGKILL");
+    await closed;
+  }
+});
