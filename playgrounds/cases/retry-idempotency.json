{
  "schema_version": 1,
  "name": "retry-idempotency",
  "description": "Ambiguous response loss, duplicate effects, request identity, and key misuse.",
  "timeout_seconds": 5,
  "cases": [
    {
      "id": "safe-retry-after-lost-response",
      "tags": ["integration-context", "retry", "idempotency"],
      "stdin_json": {
        "mode": "idempotent",
        "requests": [
          {
            "key": "order-123",
            "payload": {"sku": "A", "quantity": 1},
            "response_lost": true
          },
          {
            "key": "order-123",
            "payload": {"sku": "A", "quantity": 1}
          }
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_contains": "\"replayed\": true"
      }
    },
    {
      "id": "naive-retry-duplicates-effect",
      "tags": ["integration-context", "retry", "duplicate-effect"],
      "stdin_json": {
        "mode": "naive",
        "requests": [
          {
            "key": "order-123",
            "payload": {"sku": "A", "quantity": 1},
            "response_lost": true
          },
          {
            "key": "order-123",
            "payload": {"sku": "A", "quantity": 1}
          }
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_contains": "\"mode\": \"naive\""
      }
    },
    {
      "id": "key-reuse-with-different-payload",
      "tags": ["integration-context", "idempotency", "conflict"],
      "stdin_json": {
        "mode": "idempotent",
        "requests": [
          {
            "key": "order-123",
            "payload": {"sku": "A", "quantity": 1}
          },
          {
            "key": "order-123",
            "payload": {"sku": "B", "quantity": 1}
          }
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_contains": "idempotency-key-reused-with-different-payload"
      }
    },
    {
      "id": "distinct-operations-remain-distinct",
      "tags": ["integration-context", "idempotency", "operation-identity"],
      "stdin_json": {
        "mode": "idempotent",
        "requests": [
          {
            "key": "order-123",
            "payload": {"sku": "A", "quantity": 1}
          },
          {
            "key": "order-124",
            "payload": {"sku": "A", "quantity": 1}
          }
        ]
      },
      "expect": {
        "exit_code": 0,
        "stdout_contains": "\"key\": \"order-124\""
      }
    }
  ]
}
