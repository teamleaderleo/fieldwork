diff --git a/Tests/RunCMake/Ninja/EmptyCustomCommand-check.cmake b/Tests/RunCMake/Ninja/EmptyCustomCommand-check.cmake
new file mode 100644
--- /dev/null
+++ b/Tests/RunCMake/Ninja/EmptyCustomCommand-check.cmake
@@ -0,0 +1,5 @@
+file(READ "${RunCMake_TEST_BINARY_DIR}/build.ninja" build_ninja)
+if(NOT "${build_ninja}" MATCHES "build empty[^:]*: phony")
+  set(RunCMake_TEST_FAILED
+    "Expected an evaluated-empty custom command to generate a phony rule")
+endif()
