# EXPERIMENT C — command-local root-path hint
#
# Base: astral-sh/uv@95637ecf70cbf3c8a8d11f424b9a654e8fefdf51
# Carrier: teamleaderleo/uv#92
# Public issue: https://redirect.github.com/astral-sh/uv/issues/21058
#
# This is an internal design experiment, not an upstream submission.
# It keeps A's one-file command-local error boundary but puts the already-known
# tool-root path directly in the invalid-name recovery hint.

From f7730d8266d145bdd1cfae6633a2ce39f4679689 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Prototype tool-root path inventory diagnostic

---
 crates/uv/src/commands/tool/upgrade.rs | 26 ++++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/crates/uv/src/commands/tool/upgrade.rs b/crates/uv/src/commands/tool/upgrade.rs
index 5f954b2ce8c..b4a3b8f1d5e 100644
--- a/crates/uv/src/commands/tool/upgrade.rs
+++ b/crates/uv/src/commands/tool/upgrade.rs
@@ -23,7 +23,7 @@ use uv_python::{
 };
 use uv_requirements::RequirementsSpecification;
 use uv_settings::{Combine, PythonInstallMirrors, ResolverInstallerOptions, ToolOptions};
-use uv_tool::{InstalledTools, Tool};
+use uv_tool::{Error as ToolError, InstalledTools, Tool};
 use uv_types::{HashStrategy, SourceTreeEditablePolicy};
 use uv_workspace::WorkspaceCache;
 
@@ -65,9 +65,27 @@ pub(crate) async fn upgrade(
     // Collect the tools to upgrade, along with any constraints.
     let names: BTreeMap<PackageName, Vec<Requirement>> = {
         if names.is_empty() {
-            installed_tools
-                .tools()
-                .unwrap_or_default()
+            let tools = match installed_tools.tools() {
+                Ok(tools) => tools,
+                Err(err) => {
+                    let hints = if matches!(&err, ToolError::ToolName(_)) {
+                        Hints::from(format!(
+                            "Inspect the uv tool directory at `{}`; move, rename, or remove the invalid directory",
+                            installed_tools.root().display()
+                        ))
+                    } else {
+                        Hints::none()
+                    };
+                    let err = anyhow::Error::new(err).context("Failed to enumerate installed tools");
+                    write_error_chain_with_options(
+                        err.as_ref(),
+                        hints,
+                        ErrorOptions::default().with_stream(printer.stderr()),
+                    )?;
+                    return Ok(ExitStatus::Error);
+                }
+            };
+            tools
                 .into_iter()
                 .map(|(name, _)| (name, Vec::new()))
                 .collect()
