diff --git a/packages/python-sdk/upstash_box/_cancellation.py b/packages/python-sdk/upstash_box/_cancellation.py
new file mode 100644
index 0000000..68692a5
--- /dev/null
+++ b/packages/python-sdk/upstash_box/_cancellation.py
@@ -0,0 +1,45 @@
+"""Runtime-specific at-most-once cancellation request coordination."""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+from concurrent.futures import Future
+from typing import Any, Callable, Coroutine, Generic, Optional, TypeVar
+
+T = TypeVar("T")
+
+
+class AsyncCancellationCoordinator(Generic[T]):
+    """Share one task while isolating it from cancellation of any waiter."""
+
+    def __init__(self) -> None:
+        self._task: Optional[asyncio.Task[T]] = None
+
+    async def run(self, operation: Callable[[], Coroutine[Any, Any, T]]) -> T:
+        if self._task is None:
+            self._task = asyncio.create_task(operation())
+        return await asyncio.shield(self._task)
+
+
+class SyncCancellationCoordinator(Generic[T]):
+    """Share one operation and result across concurrent synchronous callers."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._future: Optional[Future[T]] = None
+
+    def run(self, operation: Callable[[], T]) -> T:
+        with self._lock:
+            owner = self._future is None
+            if owner:
+                self._future = Future()
+            future = self._future
+
+        assert future is not None
+        if owner:
+            try:
+                future.set_result(operation())
+            except BaseException as error:
+                future.set_exception(error)
+        return future.result()
