index ac1b71d..2fe2d58 100644
--- a/packages/python-sdk/tests/_async/test_run.py
+++ b/packages/python-sdk/tests/_async/test_run.py
@@ -7,7 +7,7 @@ RUN_URL = f"{BASE}/run/stream"
 
 
 @respx.mock
-async def test_run_cancel_sets_status_and_swallows_errors():
+async def test_run_cancel_preserves_status_and_shared_failure_receipt():
     box = await make_async_box(respx.mock)
     respx.post(RUN_URL).mock(
         return_value=sse_response(
@@ -18,12 +18,19 @@ async def test_run_cancel_sets_status_and_swallows_errors():
         )
     )
     run = await box.agent.run(prompt="x")
-    # Cancel endpoint returns an error — cancel() must not raise.
-    respx.post(f"{BASE}/runs/r1/cancel").mock(
-        return_value=httpx.Response(500, json={"error": "nope"})
+    route = respx.post(f"{BASE}/runs/r1/cancel").mock(
+        return_value=httpx.Response(500, json={"error": "provider detail"})
     )
-    await run.cancel()
-    assert run.status == "cancelled"
+
+    assert await run.cancel() is None
+    receipt = await run.request_cancel()
+
+    assert run.status == "completed"
+    assert receipt.request_state == "failed"
