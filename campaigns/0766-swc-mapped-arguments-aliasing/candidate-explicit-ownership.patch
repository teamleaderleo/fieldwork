diff --git a/crates/swc_ecma_minifier/src/program_data.rs b/crates/swc_ecma_minifier/src/program_data.rs
--- a/crates/swc_ecma_minifier/src/program_data.rs
+++ b/crates/swc_ecma_minifier/src/program_data.rs
@@
         /// The variable is declared without initializer.
         const LAZY_INIT                 = 1 << 25;
+
+        /// The variable is a parameter of an ordinary function whose lexical
+        /// `arguments` binding is used. This follows the binding through
+        /// inline remapping via `VarUsageInfo::clone`.
+        const FN_PARAM_OF_ARGUMENTS_FN  = 1 << 26;
@@
                     *e_flags |= var_info_flags & VarUsageInfoFlags::USED_RECURSIVELY;
                     *e_flags |= var_info_flags & VarUsageInfoFlags::USED_IN_NON_CHILD_FN;
+                    *e_flags |= var_info_flags & VarUsageInfoFlags::FN_PARAM_OF_ARGUMENTS_FN;
@@
 impl VarDataLike for VarUsageInfo {
@@
     fn mark_declared_as_fn_param(&mut self) {
         self.flags.insert(VarUsageInfoFlags::DECLARED_AS_FN_PARAM);
     }
+
+    fn mark_fn_param_of_arguments_fn(&mut self) {
+        self.flags
+            .insert(VarUsageInfoFlags::FN_PARAM_OF_ARGUMENTS_FN);
+    }
